{
  "name": "cashcontrol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "ui:dev": "vite --config web/vite.config.ts",
    "ui:build": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "ui:check": "tsc --noEmit -p web/tsconfig.json",
    "ui:test": "node --experimental-strip-types --test web/tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@cloudflare/workers-types": "5.20261109.1",
    "wrangler": "4.159.0",
    "vite": "^8.3.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "better-auth-cloudflare": "0.4.1",
    "hono": "4.13.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "@better-auth/core": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18"
  }
}
